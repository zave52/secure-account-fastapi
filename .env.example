APP_NAME=Secure Account
SECRET_KEY=change-this-development-key
DATABASE_URL=sqlite+aiosqlite:///./security.db
SESSION_TTL_MINUTES=10080
TOKEN_TTL_HOURS=24
CAPTCHA_TTL_SECONDS=300
# Cloudflare Turnstile. Set enabled=true after creating a widget.
CLOUDFLARE_TURNSTILE_ENABLED=false
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin!2026#Secure
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional; otherwise the request host is used.
OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000
# Real email delivery via Gmail SMTP. Use a Google App Password, not your
# normal account password. Keep these values only in .env.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Secure Account
SMTP_STARTTLS=true
